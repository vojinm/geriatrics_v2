<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medical_hospital_building_list" model="ir.ui.view">
        <field name="name">medical.hospital.building.list</field>
        <field name="model">medical.hospital.building</field>
        <field name="arch" type="xml">
            <list string="Objekti">
                <field name="name"/>
                <field name="code"/>
                <field name="institution_id"/>
            </list>
        </field>
    </record>

    <record id="view_medical_hospital_building_form" model="ir.ui.view">
        <field name="name">medical.hospital.building.form</field>
        <field name="model">medical.hospital.building</field>
        <field name="arch" type="xml">
            <form string="Objekat">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="institution_id"/>
                        <field name="extra_info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_medical_hospital_building" model="ir.actions.act_window">
            <field name="name">Objekti</field>
            <field name="res_model">medical.hospital.building</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_medical_hospital_building"
            name="Objekti"
            parent="menu_health_centers"
            action="action_medical_hospital_building"
            sequence="20"/>
</odoo>
