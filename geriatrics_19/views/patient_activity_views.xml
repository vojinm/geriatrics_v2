<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_activity_list" model="ir.ui.view">
        <field name="name">medical.patient.activities.list</field>
            <field name="model">medical.patient.activities</field>
            <field name="arch" type="xml">
                <list string="Aktivnosti pacijenata">
                    <field name="name"/>
                    <field name="notes"/>
                </list>
            </field>
        </record>

        <record id="view_patient_activity_form" model="ir.ui.view">
            <field name="name">medical.patient.activities.form</field>
            <field name="model">medical.patient.activities</field>
            <field name="arch" type="xml">
                <form string="Aktivnost pacijenta">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_open_patient_activity" model="ir.actions.act_window">
            <field name="name">Aktivnosti pacijenata</field>
            <field name="res_model">medical.patient.activities</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem
            id="menu_patient_activities"
            name="Aktivnosti pacijenata"
            parent="geriatrics_19.menu_geriatrics_root"
            action="action_open_patient_activity"
            sequence="20"/>
    </odoo>