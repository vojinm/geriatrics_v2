<odoo>
    <!-- Inpatient Request Reason -->
    <record id="view_inpatient_request_reason_list" model="ir.ui.view">
        <field name="name">medical.inpatient.request.reason.list</field>
        <field name="model">medical.inpatient.request.reason</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="info"/>
            </list>
        </field>
    </record>

    <record id="view_inpatient_request_reason_form" model="ir.ui.view">
        <field name="name">medical.inpatient.request.reason.form</field>
        <field name="model">medical.inpatient.request.reason</field>
        <field name="arch" type="xml">
            <form string="Razlog hospitalizacije">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="info"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inpatient_request_reason" model="ir.actions.act_window">
        <field name="name">Razlozi hospitalizacije</field>
        <field name="res_model">medical.inpatient.request.reason</field>
        <field name="view_mode">list,form</field>
    </record>

