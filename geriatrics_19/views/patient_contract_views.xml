<odoo>
    <!-- Lista ugovora -->
    <record id="view_patient_contract_list" model="ir.ui.view">
        <field name="name">medical.patient.contract.list</field>
        <field name="model">medical.patient.contract</field>
        <field name="arch" type="xml">
            <list string="Ugovori">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="requester_id"/>
                <field name="contractor_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Formular ugovora -->
    <record id="view_patient_contract_form" model="ir.ui.view">
        <field name="name">medical.patient.contract.form</field>
        <field name="model">medical.patient.contract</field>
        <field name="arch" type="xml">
            <form string="Ugovor pacijenta">
                <sheet>
                    <group>
                        <group string="Osnovni podaci">
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="requester_id"/>
                            <field name="contractor_id"/>
                        </group>
                        <group string="Trajanje i status">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Napomene">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Akcija za otvaranje ugovora -->
    <record id="action_open_contract" model="ir.actions.act_window">
        <field name="name">Ugovori</field>
        <field name="res_model">medical.patient.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Akcija za otvaranje ugovora -->
    <record id="action_medical_patient_contract" model="ir.actions.act_window">
        <field name="name">Ugovori</field>
        <field name="res_model">medical.patient.contract</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--Menu Ugovori-->
    <menuitem
        id="menu_medical_patient_contract"
        name="Ugovori"
        parent="menu_geriatrics_root"
        action="action_medical_patient_contract"
        sequence="20"/>
</odoo>