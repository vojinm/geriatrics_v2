
<odoo>
    <record id="view_medical_patient_kanban" model="ir.ui.view">
        <field name="name">medical.patient.kanban</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="display_name"/>
                <field name="patient_number"/>
                <field name="image_1920"/>
                <field name="sex"/>
                <field name="birthdate"/>
                <field name="age"/>

                <templates>
                    <t t-name="card">
                        <div class="d-flex gap-3">
                            <field name="image_1920"
                                   widget="image"
                                   class="oe_avatar"
                                   style="width: 80px; height: 80px; object-fit: cover;"/>

                            <div class="flex-grow-1">
                                <strong>
                                    <field name="display_name"/>
                                </strong>

                                <div>
                                    <strong>Broj pacijenta: </strong>
                                    <field name="patient_number"/>
                                </div>
                                <div>
                                    <strong>Pol: </strong>
                                    <field name="sex"/>
                                </div>
                                <div>
                                    <strong>Datum rođenja: </strong>
                                    <t t-if="record.birthdate.raw_value">
                                        <t t-esc="record.birthdate.raw_value.slice(0, 10).split('-').reverse().join('.')"/>
                                    </t>
                                </div>
                                <div>
                                    <strong>Starost: </strong>
                                    <field name="age"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_medical_patient_list" model="ir.ui.view">
        <field name="name">medical.patient.list</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <list string="Pacijenti">
                <!-- Osnovni podaci -->
                <field name="patient_number" optional="show"/>
                <field name="name" optional="show"/>
                <field name="lastname" optional="show"/>
                <field name="age" string="Starost" optional="show"/>
                <field name="sex" string="Pol" optional="show"/>
                <field name="active" string="Aktivan" optional="show"/>
                <field name="deceased" string="Preminuo" optional="show"/>

                <!-- Trenutni smještaj -->
                <field name="hospitalization_institution_id"
                    string="Ustanova" optional="hide"/>
                <field name="hospitalization_building_id"
                    string="Objekat" optional="hide"/>
                <field name="hospitalization_unit_id"
                    string="Odjel" optional="show"/>
                <field name="hospitalization_ward_id"
                    string="Soba" optional="show"/>
                <field name="hospitalization_bed_id"
                    string="Krevet" optional="hide"/>
            </list>
        </field>
    </record>


    <record id="view_medical_patient_form" model="ir.ui.view">
        <field name="name">medical.patient.form</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <form string="Karton pacijenta">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_inpatient"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-hospital-o">
                            <field
                                name="inpatient_count"
                                widget="statinfo"
                                string="Hospitalizacija"/>
                        </button>
                        <button
                            name="action_view_tracking"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tasks">
                            <field
                                name="tracking_count"
                                widget="statinfo"
                                string="Praćenje aktivnosti"/>
                        </button>
                        <button
                            name="action_view_contracts"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                            <field
                                name="contract_count"
                                widget="statinfo"
                                string="Ugovori"/>
                        </button>
                    </div>

                    <field name="partner_id" invisible="1"/>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <field name="image_1920"
                            widget="image"
                            class="oe_avatar"
                            options="{'preview_image': 'image_1920'}"/>

                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>
                    </div>

                    <group>
                        <group string="Osnovni podaci">
                            <field name="name"/>
                            <field name="lastname"/>
                            <field name="patient_number"/>
                            <field name="jmbg"
                                groups="geriatrics_19.group_patient_sensitive_data"/>
                            <field name="birthdate"/>
                            <field name="age" readonly="1"/>
                            <field name="sex"/>
                        </group>

                        <group string="Status">
                            <field name="active"/>
                            <field name="deceased"/>
                            <field name="dod" invisible="not deceased"/>

                            <field name="hospitalization_unit_id"
                                string="Trenutni odjel"
                                readonly="1"
                                options="{'no_open': True}"/>

                            <field name="hospitalization_ward_id"
                                string="Trenutna soba"
                                readonly="1"
                                options="{'no_open': True}"/>

                            <field name="hospitalization_bed_id"
                                string="Trenutni krevet"
                                readonly="1"
                                options="{'no_open': True}"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Opšte informacije" name="general_information">

                            <group>
                                <group string="Lični i zdravstveni podaci">
                                    <field name="marital_status"/>
                                    <field name="blood_type"/>
                                    <field name="rh"/>
                                    <field name="body_deformation_ids" widget="many2many_tags"/>
                                    <field name="mind_deformation_ids" widget="many2many_tags"/>
                                </group>

                                <group string="Kontakt">
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="street"/>
                                    <field name="city"/>
                                </group>
                            </group>

                            <group string="Važne medicinske informacije">
                                <label for="critical_info"
                                    string="Bolesti, alergije, operacije i druge značajne medicinske informacije"
                                    colspan="2"/>
                                <field name="critical_info"
                                    nolabel="1"
                                    colspan="2"/>
                            </group>

                            <group string="Dodatne informacije">
                                <label for="general_info"
                                    string="Opšte informacije o pacijentu"
                                    colspan="2"/>
                                <field name="general_info"
                                    nolabel="1"
                                    colspan="2"/>
                            </group>

                        </page>

                        <page string="Lični podaci" name="personal_data">

                            <group>
                                <group string="Rođenje">
                                    <field name="birth_place"/>
                                    <field name="birth_municipalities"/>
                                    <field name="birth_country_id"/>
                                </group>

                                <group string="Porodični podaci">
                                    <field name="maiden_name"/>
                                    <field name="father_name"/>
                                    <field name="mother_name"/>
                                    <field name="mother_surname"/>
                                    <field name="husband_name"/>
                                </group>
                            </group>

                            <group string="Lični dokument">
                                <field name="id_number"
                                    groups="geriatrics_19.group_patient_sensitive_data"/>
                                <field name="id_expiration_date"
                                    groups="geriatrics_19.group_patient_sensitive_data"/>
                            </group>

                        </page>

                        <page string="Socioekonomski podaci" name="socioeconomic_data">

                            <group>
                                <group string="Obrazovanje i penzija">
                                    <field name="education"/>
                                    <field name="occupation"/>
                                    <field name="is_pensioner"/>
                                    <field name="pension_type"
                                        invisible="not is_pensioner"/>
                                    <field name="pension_unique_no"
                                        invisible="not is_pensioner"/>
                                </group>
                            </group>

                            <separator string="Osiguranje" colspan="2"/>
                            <group col="1" colspan="2">
                                <field name="insured_via" nolabel="1">
                                    <list editable="bottom">
                                        <field name="number"/>
                                        <field name="name" column_invisible="True"/>
                                        <field name="type"/>
                                        <field name="company"/>
                                        <field name="member_since"/>
                                        <field name="member_exp"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Imovina">
                                <field name="property_owned" nolabel="1"/>
                            </group>

                            <group string="Dodatne informacije">
                                <field name="ses_notes" nolabel="1"/>
                            </group>

                        </page>

                        <page string="Kontakt i adresa" name="contact_data">
                            <group>
                                <field name="phone"/>
                                <field name="mobile"/>
                                <field name="email"/>
                                <field name="street"/>
                                <field name="street2"/>
                                <field name="zip"/>
                                <field name="city"/>
                                <field name="country_id"/>
                            </group>
                        </page>

                        <page string="Članovi porodice" name="family_data">
                            <field name="family_relation_ids" readonly="1">
                                <list>
                                    <field name="family_partner_id"/>
                                    <field name="relationship_type_id"/>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>

                        <page string="Plan zaštite" name="care_plan">

                            <group string="Procjena stanja" col="2">
                                <label for="current_functioning"
                                    string="Procjena trenutnog funkcionisanja"
                                    colspan="2"/>
                                <field name="current_functioning"
                                    nolabel="1"
                                    colspan="2"/>

                                <label for="adaptation_help"
                                    string="Pomoć pri adaptaciji"
                                    colspan="2"/>
                                <field name="adaptation_help"
                                    nolabel="1"
                                    colspan="2"/>
                            </group>

                            <group string="Planirane aktivnosti" col="2">
                                <label for="family_plan"
                                    string="Plan rada s porodicom"
                                    colspan="2"/>
                                <field name="family_plan"
                                    nolabel="1"
                                    colspan="2"/>

                                <label for="freetime_plan"
                                    string="Plan slobodnog vremena"
                                    colspan="2"/>
                                <field name="freetime_plan"
                                    nolabel="1"
                                    colspan="2"/>
                            </group>

                            <group string="Ciljevi" col="2">
                                <label for="short_goals"
                                    string="Kratkoročni ciljevi"
                                    colspan="2"/>
                                <field name="short_goals"
                                    nolabel="1"
                                    colspan="2"/>

                                <label for="long_goals"
                                    string="Dugoročni ciljevi"
                                    colspan="2"/>
                                <field name="long_goals"
                                    nolabel="1"
                                    colspan="2"/>
                            </group>

                        </page>


                        <page string="Ugovori" name="contracts">
                            <field name="contract_ids">
                                <list string="Ugovori">
                                    <field name="name"/>
                                    <field name="date_signed" string="Datum potpisa"/>
                                    <field name="requester_id"/>
                                    <field name="contractor_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Aktivnosti i praćenje" name="patient_tracking">
                            <group string="Aktivnosti pacijenta">
                                <field name="activities_id"
                                    widget="many2many_tags"
                                    options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>

                            <separator string="Evidencija rada s pacijentom"/>
                            <field name="tracking_list_ids">
                                <list string="Evidencija rada" default_order="date desc, id desc">
                                    <field name="date"/>
                                    <field name="info"/>
                                    <field name="create_uid" string="Evidentirao" readonly="1"/>
                                </list>
                                <form string="Evidencija rada s pacijentom">
                                    <group>
                                        <field name="date"/>
                                        <field name="info"/>
                                        <field name="create_uid" string="Evidentirao" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_patient_search" model="ir.ui.view">
        <field name="name">medical.patient.search</field>
        <field name="model">medical.patient</field>
        <field name="arch" type="xml">
            <search string="Pretraga pacijenata">
                <field name="display_name" string="Pacijent"/>
                <field name="patient_number"/>

                <separator/>

                <filter name="active_patients"
                        string="Aktivni pacijenti"
                        domain="[('active', '=', True)]"/>

                <filter name="inactive_patients"
                        string="Neaktivni pacijenti"
                        domain="[('active', '=', False), ('deceased', '=', False)]"/>

                <filter name="deceased_patients"
                        string="Preminuli pacijenti"
                        domain="[('deceased', '=', True)]"/>

                <separator/>

                <field name="hospitalization_institution_id"
                    string="Ustanova"/>

                <field name="hospitalization_building_id"
                    string="Objekat"/>

                <field name="hospitalization_unit_id"
                    string="Odjel"/>

                <field name="hospitalization_ward_id"
                    string="Soba"/>

                <field name="hospitalization_bed_id"
                    string="Krevet"/>

                <group>
                    <filter name="group_by_institution"
                            string="Ustanova"
                            context="{'group_by': 'hospitalization_institution_id'}"/>

                    <filter name="group_by_building"
                            string="Objekat"
                            context="{'group_by': 'hospitalization_building_id'}"/>

                    <filter name="group_by_unit"
                            string="Odjel"
                            context="{'group_by': 'hospitalization_unit_id'}"/>

                    <filter name="group_by_ward"
                            string="Soba"
                            context="{'group_by': 'hospitalization_ward_id'}"/>
                </group>

                <separator/>
            </search>
        </field>
    </record>

    <record id="action_medical_patient" model="ir.actions.act_window">
        <field name="name">Pacijenti</field>
        <field name="res_model">medical.patient</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_medical_patient_search"/>
        <field name="context">{'search_default_active_patients': 1, 'active_test': False}</field>
    </record>

<menuitem
    id="menu_geriatrics_root"
    name="Gerijatrija"
    sequence="10"/>
    
<menuitem
    id="menu_medical_patient"
    name="Pacijenti"
    parent="menu_geriatrics_root"
    action="action_medical_patient"
    sequence="10"/>

<menuitem
    id="menu_patient_administration"
    name="Administracija pacijenata"
    parent="menu_geriatrics_root"
    sequence="20"/>

</odoo>