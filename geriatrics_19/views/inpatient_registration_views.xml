<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lista hospitalizacija -->
    <record id="view_inpatient_registration_list" model="ir.ui.view">
        <field name="name">medical.inpatient.registration.list</field>
        <field name="model">medical.inpatient.registration</field>
        <field name="arch" type="xml">
            <list string="Hospitalizacije">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="hospitalization_date"/>
                <field name="discharge_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Forma hospitalizacije -->
    <record id="view_inpatient_registration_form" model="ir.ui.view">
        <field name="name">medical.inpatient.registration.form</field>
        <field name="model">medical.inpatient.registration</field>
        <field name="arch" type="xml">
            <form string="Hospitalizacija">
                <header>
                    <button
                        name="action_admit"
                        type="object"
                        string="Primi pacijenta"
                        class="btn-primary"
                        invisible="state!= 'draft'"/>
                    <button
                        name="action_cancel"
                        type="object"
                        string="Otkaži prijem"
                        invisible="state != 'draft'"
                        confirm="Da li ste sigurni da želite otkazati prijem pacijenta?"/>
                    <button
                        name="action_discharge"
                        type="object"
                        string="Otpusti pacijenta"
                        class="btn-primary"
                        invisible="state != 'hospitalized'"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="patient_id"/>
                        <field name="medical_hospital_unit_id"/>
                        <field name="bed_id"/>
                        <field name="hospitalization_date"/>
                        <field name="discharge_date"/>
                        <field name="discharge_reason"
                            invisible="state == 'draft'"/>
                        <field name="cancellation_reason"
                            invisible="state not in ['draft', 'cancelled']"/>
                        <field name="state" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Akcija za otvaranje hospitalizacija -->
    <record id="action_inpatient_registration" model="ir.actions.act_window">
        <field name="name">Hospitalizacije</field>
        <field name="res_model">medical.inpatient.registration</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Stavka u meniju Administracija pacijenata -->
    <menuitem
        id="menu_inpatient_registration"
        name="Hospitalizacije"
        parent="menu_patient_administration"
        action="action_inpatient_registration"
        sequence="10"/>

</odoo>
