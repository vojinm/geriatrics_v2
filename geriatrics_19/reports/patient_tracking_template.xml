<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_patient_tracking">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">

                        <h2 style="text-align: center;">
                            LIST PRAĆENJA
                        </h2>

                        <h3 style="text-align: center;">
                            <span t-field="o.display_name"/>
                            <br/>
                            <span t-field="o.patient_number"/>
                        </h3>

                        <table style="width: 100%; margin-top: 30px; border-collapse: collapse; table-layout: fixed;">
                            <colgroup>
                                <col style="width: 20%;"/>
                                <col style="width: 55%;"/>
                                <col style="width: 25%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th style="text-align: left; padding: 6px 8px;">Datum</th>
                                    <th style="text-align: left; padding: 6px 8px;">Obavljena aktivnost</th>
                                    <th style="text-align: left; padding: 6px 8px;">Razgovor obavio</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.tracking_list_ids.sorted('date')" t-as="entry">
                                    <td style="text-align: left; padding: 6px 8px; vertical-align: top;">
                                        <span t-field="entry.date"
                                            t-options='{"widget": "date", "format": "dd.MM.yyyy."}'/>
                                    </td>
                                    <td style="text-align: left; padding: 6px 8px; vertical-align: top;">
                                        <span t-field="entry.info"/>
                                    </td>
                                    <td style="text-align: left; padding: 6px 8px; vertical-align: top;">
                                        <span t-field="entry.create_uid.name"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="height: 140px;"></div>

                        <div style="text-align: right; padding-right: 20px;">
                            <div style="display: inline-block; width: 180px; text-align: center;">
                                ____________________<br/>
                                (potpis)
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>