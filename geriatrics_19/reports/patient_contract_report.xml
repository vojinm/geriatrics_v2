<odoo>
    <record id="paperformat_patient_contract" model="report.paperformat">
        <field name="name">Gerijatrija - Ugovor A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">20</field>
        <field name="margin_right">20</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_patient_contract" model="ir.actions.report">
        <field name="name">Ugovor o smještaju</field>
        <field name="model">medical.patient.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_patient_contract"/>
        <field name="report_name">geriatrics_19.report_patient_contract_document</field>
        <field name="report_file">geriatrics_19.report_patient_contract_document</field>
        <field name="binding_model_id" ref="model_medical_patient_contract"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Ugovor - %s' % (object.name or '')</field>
    </record>
</odoo>
