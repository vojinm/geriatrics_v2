<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_geriatrics_report_selection_form"
            model="ir.ui.view">
        <field name="name">geriatrics.report.selection.form</field>
        <field name="model">geriatrics.report.selection</field>
        <field name="arch" type="xml">
            <form string="Spisak promjena za period">
                <sheet>
                    <group>
                        <field name="report_type"/>
                        <field name="month"/>
                        <field name="year" options="{'enable_formatting': false}"/>
                    </group>

                    <group invisible="state != 'get'">
                        <field name="file_data"
                               filename="file_name"
                               readonly="1"/>
                        <field name="file_name" invisible="1"/>
                    </group>

                    <field name="state" invisible="1"/>
                </sheet>

                <footer>
                    <button name="action_generate_report"
                            string="Generiši izvještaj"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'get'"/>

                    <button string="Zatvori"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_geriatrics_report_selection"
            model="ir.actions.act_window">
        <field name="name">Spisak promjena za period</field>
        <field name="res_model">geriatrics.report.selection</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_geriatrics_report_selection"
        name="Spisak promjena za period"
        parent="menu_geriatrics_reports"
        action="action_geriatrics_report_selection"
        sequence="10"/>

</odoo>
